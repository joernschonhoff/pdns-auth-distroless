PDNS_API_KEY=secret_api_key
PDNS_API=yes
PDNS_PRIMARY=yes
PDNS_SECONDARY=yes
PDNS_WEBSERVER_ADDRESS=0.0.0.0
PDNS_WEBSERVER_ALLOW_FROM=0.0.0.0/0
PDNS_WEBSERVER_PORT=8081
PDNS_WEBSERVER=yes

PDNS_LAUNCH=gpgsql
PDNS_GPGSQL_DBNAME=pdns
PDNS_GPGSQL_HOST=postgres
PDNS_GPGSQL_PASSWORD=secret_password
PDNS_GPGSQL_PORT=5432
PDNS_GPGSQL_USER=postgres

POSTGRES_USER=${PDNS_GPGSQL_USER}
POSTGRES_PASSWORD=${PDNS_GPGSQL_PASSWORD}
POSTGRES_DB=${PDNS_GPGSQL_DBNAME}

PDNS_LOGLEVEL=7
